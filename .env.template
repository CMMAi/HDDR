# Copy this file to `.env` and fill in the values.
# `.env` is gitignored.

# OpenAI API key used for GPT-4o / o4-mini and text-embedding-3-small
OPENAI_API_KEY=

# Neo4j connection (vector index used for page retrieval)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
